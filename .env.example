# Blizzard Battle.net Developer Portal — https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu

# LLM sağlayıcısı: google | ollama | anthropic
LLM_PROVIDER=google

# Google Gemini — https://aistudio.google.com (ücretsiz katman, kart gerekmez)
# Ücretsiz katmanda kota MODEL BAŞINA sayılır: listeye birden çok model yazmak hem yedek hem ek kota demektir.
# Günlük kota Pasifik gece yarısında (TR 10:00) sıfırlanır. Kota dolunca uygulama "busy" gösterir.
GOOGLE_GENERATIVE_AI_API_KEY=
# Niyet çözümleme: hızlı/ucuz yeter
LLM_MODEL_INTENT=gemini-3.5-flash,gemini-3.5-flash-lite
# Deste kurma: en güçlü Flash önce (3.8), yoğunsa 3.5'e düşer. Virgülle yedek: ilki yoğun/kota doluysa sonrakine geçilir
LLM_MODEL_BUILD=gemini-3.8-flash,gemini-3.5-flash
# Gemini düşünme seviyesi (minimal|low|medium|high). Kalite için build=medium, hız için low.
LLM_THINKING_INTENT=minimal
LLM_THINKING_BUILD=medium
# Çağrı zaman aşımı (ms); dolunca yedek modele geçilir. Varsayılan intent 15000, build 60000
# LLM_TIMEOUT_INTENT_MS=15000
# LLM_TIMEOUT_BUILD_MS=60000

# Ollama (yerel geliştirme) — LLM_PROVIDER=ollama iken
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_INTENT=qwen3:8b
# LLM_MODEL_BUILD=qwen3:14b

# Anthropic (opsiyonel) — LLM_PROVIDER=anthropic iken
# ANTHROPIC_API_KEY=
# LLM_MODEL_INTENT=claude-haiku-4-5
# LLM_MODEL_BUILD=claude-sonnet-4-5

# İstek limiti: IP başına 10 dakikada kaç forge/refine (varsayılan 8)
# RATE_LIMIT_FORGE=8

# Site adresi (OG/sitemap için). Boşsa Vercel'in verdiği host kullanılır.
# NEXT_PUBLIC_SITE_URL=https://deckforge.example

# Yayın (Vercel) — günlük kart senkronu için: cron /api/cron/redeploy'u çağırır, o da Deploy Hook'u tetikler
# CRON_SECRET=            # Vercel otomatik üretir (Settings → Environment Variables); yerelde gereksiz
# VERCEL_DEPLOY_HOOK_URL= # Vercel → Settings → Git → Deploy Hooks → Create Hook

# Opsiyonel
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
