# Blizzard Battle.net Developer Portal — https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu

# LLM provider: google | ollama | anthropic
LLM_PROVIDER=google

# Google Gemini — https://aistudio.google.com (free tier, no credit card required)
# On the free tier, quota is counted PER MODEL: listing several models means both a fallback and extra quota.
# The daily quota resets at Pacific midnight (10:00 Turkey time). When the quota runs out the app shows "busy".
GOOGLE_GENERATIVE_AI_API_KEY=
# Intent parsing: fast/cheap is enough
LLM_MODEL_INTENT=gemini-3.5-flash,gemini-3.5-flash-lite
# Deck building: strongest Flash first (3.8), falls back to 3.5 when busy. Comma-separated fallbacks: if the first is busy/out of quota, the next one is used
LLM_MODEL_BUILD=gemini-3.8-flash,gemini-3.5-flash
# Gemini thinking level (minimal|low|medium|high). build=medium for quality, low for speed.
LLM_THINKING_INTENT=minimal
LLM_THINKING_BUILD=medium
# Call timeout (ms); on timeout the fallback model is used. Defaults: intent 15000, build 60000
# LLM_TIMEOUT_INTENT_MS=15000
# LLM_TIMEOUT_BUILD_MS=60000

# Ollama (local development) — when LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_INTENT=qwen3:8b
# LLM_MODEL_BUILD=qwen3:14b

# Anthropic (optional) — when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL_INTENT=claude-haiku-4-5
# LLM_MODEL_BUILD=claude-sonnet-4-5

# Rate limit: forge/refine requests per IP per 10 minutes (default 8)
# RATE_LIMIT_FORGE=8

# Site URL (for OG/sitemap). If empty, the host provided by Vercel is used.
# NEXT_PUBLIC_SITE_URL=https://deckforge.example

# Deployment (Vercel) — for the daily card sync: the cron calls /api/cron/redeploy, which triggers the Deploy Hook
# CRON_SECRET=            # Vercel generates it automatically (Settings → Environment Variables); not needed locally
# VERCEL_DEPLOY_HOOK_URL= # Vercel → Settings → Git → Deploy Hooks → Create Hook

# Optional
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
